<!DOCTYPE html>
<html lang="ru">
  <head>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><text y=%2228%22 font-size=%2228%22>🎮</text></svg>">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>Мигающий прыжок</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: system-ui, sans-serif;
        background: linear-gradient(180deg, #bfe9ff 0%, #e8f8ff 100%);
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2vh 2vw;
      }
      .game-wrap {
        position: relative;
        width: min(90vw, 400px);
        aspect-ratio: 2 / 3;
        border: 0.35rem solid #17324d;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 1.2rem 2.5rem rgba(0, 50, 90, 0.25);
        background: linear-gradient(180deg, #8fd7ff 0%, #dff5ff 100%);
      }
      canvas {
        display: block;
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
        background: linear-gradient(180deg, #8fd7ff 0%, #dff5ff 100%);
      }
      .ui-layer, .overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      #scoreDisplay {
        position: absolute;
        top: 3%;
        left: 4%;
        color: #17324d;
        font-size: clamp(1.3rem, 2vw, 1.8rem);
        font-weight: 800;
        text-shadow: 0.12rem 0.12rem 0 #ffffff;
        z-index: 3;
        pointer-events: none;
      }
      .overlay {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 6%;
        background: rgba(12, 41, 66, 0.28);
        z-index: 4;
        pointer-events: auto;
      }
      .hidden { display: none; }
      .panel {
        width: min(88%, 22rem);
        background: rgba(255, 255, 255, 0.92);
        border: 0.25rem solid #17324d;
        border-radius: 1rem;
        padding: 1.2rem 1rem;
        text-align: center;
        box-shadow: 0 0.8rem 1.4rem rgba(0, 0, 0, 0.18);
      }
      .panel h1, .panel h2, .panel p, .panel button {
        direction: ltr;
      }
      .panel h1, .panel h2 {
        color: #17324d;
        margin-bottom: 0.7rem;
        font-size: clamp(1.4rem, 3vw, 2rem);
      }
      .panel p {
        color: #244b68;
        margin: 0.35rem 0;
        line-height: 1.35;
        font-size: clamp(1rem, 2vw, 1.1rem);
      }
      #restartBtn {
        margin-top: 1rem;
        border: none;
        background: #ffd93d;
        color: #17324d;
        font-weight: 900;
        font-size: 1rem;
        padding: 0.85rem 1.2rem;
        border-radius: 0.8rem;
        cursor: pointer;
        pointer-events: auto;
        box-shadow: inset 0 -0.18rem 0 rgba(0,0,0,0.12), 0 0.3rem 0.7rem rgba(0,0,0,0.18);
        transition: transform 0.12s ease, filter 0.12s ease;
      }
      #restartBtn:hover { filter: brightness(1.05); }
      #restartBtn:active { transform: scale(0.97); }
    </style>
  </head>
  <body>
    <div class="game-wrap">
      <canvas id="gameCanvas" width="400" height="600"></canvas>
      <div class="ui-layer">
        <div id="scoreDisplay" dir="ltr">
          Счёт: 0
        </div>
      </div>
      <div id="startScreen" class="overlay">
        <div class="panel">
          <h1 dir="ltr">
            Мигающий прыжок
          </h1>
          <p dir="ltr">
            Нажми, чтобы начать
          </p>
          <p dir="ltr">
            Пробел, клик или тап — прыжок
          </p>
        </div>
      </div>
      <div id="gameOverScreen" class="overlay hidden">
        <div class="panel">
          <h2 dir="ltr">
            Игра окончена
          </h2>
          <p id="finalScore" dir="ltr">
            Итоговый счёт: 0
          </p>
          <p id="bestScoreText" dir="ltr">
            Рекорд: 0
          </p>
          <button id="restartBtn" type="button" dir="ltr">Играть снова</button>
        </div>
      </div>
    </div>
    <script>
      const canvas = document.getElementById('gameCanvas');
      const ctx = canvas.getContext('2d');

      const scoreDisplay = document.getElementById('scoreDisplay');
      const startScreen = document.getElementById('startScreen');
      const gameOverScreen = document.getElementById('gameOverScreen');
      const finalScore = document.getElementById('finalScore');
      const bestScoreText = document.getElementById('bestScoreText');
      const restartBtn = document.getElementById('restartBtn');

      const WIDTH = 400;
      const HEIGHT = 600;

      const PLAYER_SIZE = 30;
      const PLAYER_X = 80;
      const GRAVITY = 0.43;
      const JUMP_FORCE = -6.2;
      const MAX_FALL_SPEED = 8;

      const PIPE_WIDTH = 60;
      const PIPE_GAP = 150;
      const PIPE_SPEED = 2;
      const PIPE_SPAWN_INTERVAL = 1500;
      const GAP_MARGIN = 80;

      let gameState = 'start';
      let score = 0;
      let bestScore = 0;
      let pipes = [];
      let lastSpawnTime = 0;
      let animationId = null;

      const player = {
        x: PLAYER_X,
        y: HEIGHT * 0.45,
        size: PLAYER_SIZE,
        vy: 0
      };

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      async function loadBestScore() {
        try {
          const saved = await YuviStorage.get('blinkingJump_bestScore');
          bestScore = Number(saved) || 0;
        } catch (e) {
          bestScore = 0;
        }
        updateBestScoreUI();
      }

      async function saveBestScore() {
        try {
          await YuviStorage.set('blinkingJump_bestScore', bestScore);
        } catch (e) {
          // Если хранилище недоступно, игра всё равно работает
        }
      }

      function updateScoreUI() {
        scoreDisplay.textContent = `Счёт: ${score}`;
      }

      function updateBestScoreUI() {
        bestScoreText.textContent = `Рекорд: ${bestScore}`;
      }

      function resetGame() {
        score = 0;
        pipes = [];
        player.x = PLAYER_X;
        player.y = HEIGHT * 0.45;
        player.vy = 0;
        lastSpawnTime = 0;
        updateScoreUI();
        finalScore.textContent = 'Итоговый счёт: 0';
        updateBestScoreUI();
      }

      function startGame() {
        resetGame();
        gameState = 'playing';
        startScreen.classList.add('hidden');
        gameOverScreen.classList.add('hidden');
        jump();
      }

      function jump() {
        if (gameState === 'playing') {
          player.vy = JUMP_FORCE;
        }
      }

      function createPipe() {
        const minGapY = GAP_MARGIN;
        const maxGapY = HEIGHT - GAP_MARGIN - PIPE_GAP;
        const gapY = Math.floor(Math.random() * (maxGapY - minGapY + 1)) + minGapY;

        pipes.push({
          x: WIDTH,
          width: PIPE_WIDTH,
          gapY,
          gapHeight: PIPE_GAP,
          scored: false
        });
      }

      function rectsIntersect(a, b) {
        return (
          a.x < b.x + b.width &&
          a.x + a.width > b.x &&
          a.y < b.y + b.height &&
          a.y + a.height > b.y
        );
      }

      function endGame() {
        if (gameState !== 'playing') return;

        gameState = 'gameover';
        finalScore.textContent = `Итоговый счёт: ${score}`;

        if (score > bestScore) {
          bestScore = score;
          updateBestScoreUI();
          saveBestScore();
        } else {
          updateBestScoreUI();
        }

        gameOverScreen.classList.remove('hidden');
      }

      function updateGame(timestamp) {
        player.vy = clamp(player.vy + GRAVITY, JUMP_FORCE, MAX_FALL_SPEED);
        player.y += player.vy;

        if (player.y <= 0 || player.y + player.size >= HEIGHT) {
          player.y = clamp(player.y, 0, HEIGHT - player.size);
          endGame();
        }

        if (lastSpawnTime === 0) {
          lastSpawnTime = timestamp;
        }

        if (timestamp - lastSpawnTime >= PIPE_SPAWN_INTERVAL) {
          createPipe();
          lastSpawnTime = timestamp;
        }

        for (let i = pipes.length - 1; i >= 0; i--) {
          const pipe = pipes[i];
          pipe.x -= PIPE_SPEED;

          if (!pipe.scored && pipe.x + pipe.width < player.x) {
            pipe.scored = true;
            score += 1;
            updateScoreUI();
          }

          if (pipe.x + pipe.width < 0) {
            pipes.splice(i, 1);
            continue;
          }

          const playerRect = {
            x: player.x,
            y: player.y,
            width: player.size,
            height: player.size
          };

          const topPipe = {
            x: pipe.x,
            y: 0,
            width: pipe.width,
            height: pipe.gapY
          };

          const bottomPipe = {
            x: pipe.x,
            y: pipe.gapY + pipe.gapHeight,
            width: pipe.width,
            height: HEIGHT - (pipe.gapY + pipe.gapHeight)
          };

          if (rectsIntersect(playerRect, topPipe) || rectsIntersect(playerRect, bottomPipe)) {
            endGame();
          }
        }
      }

      function drawBackground() {
        const gradient = ctx.createLinearGradient(0, 0, 0, HEIGHT);
        gradient.addColorStop(0, '#8fd7ff');
        gradient.addColorStop(1, '#dff5ff');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, WIDTH, HEIGHT);

        ctx.fillStyle = 'rgba(255,255,255,0.45)';
        ctx.fillRect(35, 90, 70, 20);
        ctx.fillRect(42, 78, 38, 16);
        ctx.fillRect(250, 120, 85, 22);
        ctx.fillRect(275, 106, 42, 16);
      }

      function drawPipes() {
        for (const pipe of pipes) {
          ctx.fillStyle = '#1faa59';
          ctx.fillRect(pipe.x, 0, pipe.width, pipe.gapY);
          ctx.fillRect(pipe.x, pipe.gapY + pipe.gapHeight, pipe.width, HEIGHT - pipe.gapY - pipe.gapHeight);

          ctx.fillStyle = '#168a47';
          ctx.fillRect(pipe.x - 4, Math.max(0, pipe.gapY - 12), pipe.width + 8, 12);
          ctx.fillRect(pipe.x - 4, pipe.gapY + pipe.gapHeight, pipe.width + 8, 12);
        }
      }

      function drawPlayer() {
        const blink = gameState === 'playing' ? (Math.sin(performance.now() * 0.02) * 0.12 + 0.88) : 1;
        ctx.save();
        ctx.globalAlpha = clamp(blink, 0.75, 1);
        ctx.fillStyle = '#ffd93d';
        ctx.fillRect(player.x, player.y, player.size, player.size);

        ctx.fillStyle = '#fff3a0';
        ctx.fillRect(player.x + 4, player.y + 4, player.size * 0.35, player.size * 0.35);

        ctx.fillStyle = '#17324d';
        ctx.fillRect(player.x + player.size * 0.62, player.y + player.size * 0.25, 4, 4);
        ctx.restore();
      }

      function drawGroundLine() {
        ctx.fillStyle = 'rgba(23, 50, 77, 0.15)';
        ctx.fillRect(0, HEIGHT - 6, WIDTH, 6);
      }

      function render() {
        drawBackground();
        drawPipes();
        drawPlayer();
        drawGroundLine();
      }

      function gameLoop(timestamp) {
        if (gameState === 'playing') {
          updateGame(timestamp);
        }

        render();
        animationId = requestAnimationFrame(gameLoop);
      }

      function handleAction(e) {
        if (e) e.preventDefault();

        if (gameState === 'start') {
          startGame();
          return;
        }

        if (gameState === 'playing') {
          jump();
        }
      }

      document.addEventListener('keydown', (e) => {
        if (e.code === 'Space') {
          e.preventDefault();
          handleAction(e);
        }
      });

      canvas.addEventListener('pointerdown', (e) => {
        handleAction(e);
      }, { passive: false });

      startScreen.addEventListener('pointerdown', (e) => {
        handleAction(e);
      }, { passive: false });

      restartBtn.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        e.stopPropagation();
        startGame();
      }, { passive: false });

      window.addEventListener('resize', () => {
        render();
      });

      document.addEventListener('DOMContentLoaded', async () => {
        await loadBestScore();
        updateScoreUI();
        render();
        if (!animationId) {
          animationId = requestAnimationFrame(gameLoop);
        }
      });
    </script>
  </body>
</html>
